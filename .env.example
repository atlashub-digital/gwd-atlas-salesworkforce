# Copy only relevant variables to each service. Never commit runtime values.
# apps/web (server only)
GWD_API_URL=http://localhost:8080
GWD_APP_URL=http://localhost:3001
# apps/app + apps/api (server only); publishable key, never service_role
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# apps/api: a dedicated least-privilege login that can SET ROLE gwd_api
DATABASE_URL=
# apps/api optional: only approved official group links
COMMUNITY_WHATSAPP_URL=
COMMUNITY_FACEBOOK_URL=
PORT=8080
# No ARO/payment provider or payout environment variables exist.
